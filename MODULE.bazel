
bazel_dep(name = "rules_java", version = "9.7.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_scala", version = "7.2.6")
bazel_dep(name = "rules_rust", version = "0.72.0")
bazel_dep(name = "rules_rs", version = "0.0.26")
bazel_dep(name = "rules_cc", version = "0.2.22")

## SCALA

scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(scala_version = "2.13.18")
scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()
scala_deps.scala_proto()
scala_deps.jmh()
scala_deps.junit()
scala_deps.specs2()
scala_protoc = use_extension("@rules_scala//scala/extensions:protoc.bzl", "scala_protoc", dev_dependency = True)
use_repo(scala_protoc, "rules_scala_protoc_toolchains")
register_toolchains("@rules_scala_protoc_toolchains//...:all", dev_dependency = True)

use_repo(
    scala_deps,
    "io_bazel_rules_scala_scala_library",
    "io_bazel_rules_scala_scala_reflect",
    "io_bazel_rules_scala_org_openjdk_jmh_jmh_core",
    "scala_proto_rules_scalapb_runtime",
    "com_google_protobuf_protobuf_java"
)


## RUST

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021", versions = ["nightly/2026-06-01"])

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

rs = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
rs.spec(package = "base64", version = "0.13.0")
rs.spec(package = "jni", version = "0.19.0")
rs.spec(package = "libc", version = "0.2.0")
rs.spec(package = "base64-simd", git = "https://github.com/Nugine/simd", rev = "4d6b948a921083e420b3465933b20dee9356cb78")
rs.from_specs(name = "rs")
use_repo(rs, "rs")

## DEPENDENCIES

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

scala_version = "2.13"
scala_full_version = "%s.6" % scala_version
maven_repositories = ["https://repo1.maven.org/maven2"]

maven.install(
    artifacts = [
        "org.specs2:specs2-mock_%s:4.6.0" % scala_version,
        "org.slf4j:slf4j-api:1.7.25",
        "org.scala-lang.modules:scala-async_%s:0.10.0" % scala_version,
